# Arratel SaaS Template environment example.
# Copy this file to .env for local development.

# Deployment mode:
# - full: complete SaaS with auth, database, dashboard, and billing
# - minimal: public pages only, useful for quick static launches
DEPLOYMENT_MODE=full

# Site
# Use http://localhost:3000 locally.
# Use the final production URL in deployment, for example https://arratel.dev.
BASE_URL=http://localhost:3000

# Auth
# Generate a long random value for real environments.
AUTH_SECRET=dummy

# Database
# Not needed in minimal mode.
POSTGRES_URL=replace-with-your-postgres-url

# Stripe
# Keep MOCK_STRIPE=true for local UI/product work without a Stripe account.
# For production billing, set MOCK_STRIPE=false and provide real Stripe values.
MOCK_STRIPE=true
STRIPE_SECRET_KEY=dummy
STRIPE_WEBHOOK_SECRET=dummy
